  "findings": {
    "same_label_trend": "Within samples labeled iNSC, age-clock predictions decrease in 6/6 donor-matched D14-to-LP contrasts; two-sided exploratory sign p 0.03125 unadjusted. These cells still undergo molecular fate consolidation.",
    "same_slide_batch": "Sensitivity using same Illumina slide retains reductions in 3/3 eligible donors, but does not eliminate culture/time confounding.",
    "opposing_fate": "When smNPC LP is compared with iNSC LP for the same donor, the smNPC clock prediction is lower in 9/9 donors, including negative apparent ages. Strong evidence that measured clock value is fate-dependent or has severe lineage-specific floor effects, not pure age.",
    "treatment_negative_control": "LP NGN2 and glycerol conditions have higher predicted ages than untreated iNSC in 3/3 studied donors each; thymidine has mixed effects (1 higher, 2 lower). Small n=3 and distinct biological protocols.",
    "conclusion": "Evidence supports progressive loss of age-clock signal alongside maturation of iNSC cells, but does not isolate a cell-fate-independent rejuvenation mechanism."
  },
  "adversarial_and_scientific_limitations": [
    "Comparison uses retrospectively selected contrasts: p-values are exploratory and unadjusted for the several hypotheses explored.",
    "Neural identity transcriptional and methylation profiles continue to mature after day 14 (source authors), so common label iNSC is not an identity clamp.",
    "Other lineages such as smNPC have age-clock predictions at/below the model floor: predicted negative years are not biological ages.",
    "Oxygen tension and culture conditions change during conversion (authors describe hypoxia until ~day 35), additional time-varying confounding.",
    "Different array slides across some paired stages; same-slide subset has n=3, no independent wet-lab replication.",
    "Data originate from one publication and no individual-lineage-specific age-neutral methylation reference is available here.",
    "Alternative-fate contrast shows estimator lineage dependence; it does not quantify causal contributions of cellular fate to ageing."
  ],
  "negative_control_GSE74387": "FAIL_RETAINED",
  "next_required_discriminator": "Independently measured molecular identity from matched longitudinal RNA-seq or independent identity CpGs + chronological-age matched NSC reference, then estimate age-signal residual after identity adjustment with cohort- and slide-aware uncertainty.",
  "new_cost_eur": 0
}
